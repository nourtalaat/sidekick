{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Your organization",
    "websiteUrl": "https://github.com/nourtalaat/sidekick",
    "privacyUrl": "https://github.com/nourtalaat/sidekick",
    "termsOfUseUrl": "https://github.com/nourtalaat/sidekick"
  },
  "name": {
    "short": "Sidekick",
    "full": "Sidekick"
  },
  "description": {
    "short": "Investigates alerts and posts what it finds",
    "full": "Sidekick reads the alerts that monitoring bots post in the channels it is in, and the messages that mention it, and investigates them. It reads every message in the channels of the teams it is installed in, so it can pick out alerts; message text is stored in your organization's own Sidekick database and never leaves it except to the model provider your Sidekick uses."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#243165",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["team"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity"],
  "validDomains": [],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000000",
    "resource": "api://sidekick-teams-bot"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        }
      ]
    }
  }
}
